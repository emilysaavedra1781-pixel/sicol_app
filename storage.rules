rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Función auxiliar para verificar si el usuario es Admin
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // --- CARPETA USUARIOS (Fotos de perfil) ---
    match /usuarios/{userId}/{allPaths=**} {
      // Lectura permitida para cualquier usuario autenticado (para ver fotos de perfil)
      allow read: if request.auth != null;
      // Escritura solo para el dueño
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- CARPETA DOCUMENTOS (DNI, Licencia, Tarjeta Propiedad) ---
    match /conductores/{userId}/documentos/{allPaths=**} {
      // Lectura restringida SOLO al dueño y al Admin
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Escritura solo para el dueño durante el registro/actualización
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- CARPETA VEHÍCULOS ---
    match /conductores/{userId}/vehiculo.jpg {
      // Lectura pública para usuarios autenticados (para que el pasajero vea el auto)
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
